# ==============================================================================
# Model Context Protocol (MCP) Environment Variables Configuration
# ==============================================================================

# GitHub MCP Server Authentication
# Generate PAT with scopes: repo, read:org, workflow
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/forgeai

# Redis Cache & PubSub Server
# Format: redis://:[password]@[host]:[port]/[db]
REDIS_URL=redis://localhost:6379

# Qdrant Vector Database
# Format: http://[host]:[port] or https://[cluster-url]
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_optional

# Docker Daemon Host (Optional if using local named pipe/socket)
DOCKER_HOST=npipe:////./pipe/docker_engine
