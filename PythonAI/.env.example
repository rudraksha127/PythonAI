# PythonAI - Environment Configuration Template
# Copy this to .env and fill in your keys. DO NOT commit .env.

# --- Core API Keys ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# --- Alternative LLM Providers ---
MISTRAL_API_KEY=...
TOGETHER_API_KEY=...
OPENROUTER_API_KEY=sk-or-...
CEREBRAS_API_KEY=...
FIREWORKS_API_KEY=...
COHERE_API_KEY=...
AI21_API_KEY=...
ANYSCALE_API_KEY=...
PERPLEXITY_API_KEY=...
XAI_API_KEY=xai-...
NVIDIA_API_KEY=nvapi-...

# --- Local LLM Configurations ---
OLLAMA_HOST=http://localhost:11434

# --- Data Collection / GitHub APIs ---
HF_TOKEN=hf_...
GITHUB_TOKEN=ghp_...
OPENALEX_EMAIL=your@email.com

# --- Langfuse Observability (LLM tracing) ---
# Sign up at https://cloud.langfuse.com to get keys
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_HOST=https://cloud.langfuse.com
FORGEAI_TRACING_ENABLED=true

# --- Guardrails AI (Input/Output Safety) ---
# Guardrails works out-of-the-box with local heuristic checks
# No API keys needed for basic prompt injection protection.

# --- Outlines (Structured Output) ---
OUTLINES_MODEL=Qwen/Qwen2.5-1.5B-Instruct
OUTLINES_BACKEND=transformers
OUTLINES_MAX_TOKENS=2048

# --- mem0 Memory (Persistent User Memory) ---
FORGEAI_MEMORY_ENABLED=true
FORGEAI_MEMORY_STORAGE_DIR=~/.forgeai/memory

# --- Test-Time Scaling (PDR+RTV) ---
FORGEAI_TTS_ENABLED=true
FORGEAI_TTS_COMPLEXITY_THRESHOLD=0.7
FORGEAI_TTS_NUM_ROLLOUTS=5