# ═══════════════════════════════════════════════
# PythonAI — .gitignore
# ═══════════════════════════════════════════════

# ── Environment ──
.env
.env.local
.env.production

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual Environment ──
.venv/
venv/
env/

# ── Testing ──
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/

# ── IDE / Editor ──
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── OS files ──
Thumbs.db
.DS_Store
*.log

# ── Checkpoints (keep final adapter, ignore intermediate) ──
checkpoints/**/checkpoint-*/
checkpoints/local_50.json

# ── Regeneratable Data ──
data/raw/
data/processed/
extra_data/

# ── Vector DB (can be re-embedded) ──
python_brain_godmode/

# ── Large Binary / Model Files ──
*.safetensors
*.bin
*.gpickle
*.jsonl
*.gguf
*.onnx

# ── Docker ──
.docker/
docker-compose.override.yml  # Dev override — not for production

# ── Notebooks with secrets ──
*.ipynb_checkpoints/

# ── Other ──
.sixth/
nul
