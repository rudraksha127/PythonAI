{
  "base_output_dir": "./anti_gravity_data",
  "email": "your@email.com",

  "anthropic_api_key": "",
  "openai_api_key": "",
  "google_api_key": "",
  "hf_token": "",
  "github_token": "",
  "kaggle_api_key": "",
  "kaggle_api_username": "",

  "synthetic_per_task": 10000,
  "image_download_workers": 16,
  "max_concurrent_requests": 20,
  "request_delay_seconds": 0.5,
  "max_samples_per_hf_dataset": 5000000,
  "gigaspeech_subset": "l",

  "priorities": {
    "text": true,
    "images": true,
    "video": true,
    "audio": true,
    "code": true,
    "scientific": true,
    "multilingual": true,
    "synthetic": true
  },

  "phase1_sources": {
    "huggingface_datasets": true,
    "arxiv_papers": true,
    "openalex_snapshot": true,
    "openimages": false,
    "webvid": false,
    "common_voice": false,
    "synthetic": false
  },

  "dashboard": {
    "port": 8080,
    "refresh_interval": 10,
    "storage_path": "./anti_gravity_data"
  },

  "training": {
    "base_model": "sshleifer/tiny-gpt2",
    "use_lora": true,
    "lora_r": 8,
    "lora_alpha": 32,
    "lora_dropout": 0.1,
    "batch_size": 4,
    "gradient_accumulation_steps": 4,
    "learning_rate": 2e-5,
    "num_epochs": 10,
    "max_seq_length": 512,
    "save_steps": 100,
    "eval_steps": 100,
    "logging_steps": 10,
    "use_4bit": false,
    "use_8bit": false,
    "bf16": false,
    "fp16": false,
    "output_dir": "checkpoints/local_auto_model"
  }
}
