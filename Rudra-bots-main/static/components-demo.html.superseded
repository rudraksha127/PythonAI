<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Odysseus UI Components Demo</title>
  <link rel="stylesheet" href="/static/style.css">
  <link rel="stylesheet" href="/static/css/components.css">
  <style>
    .demo-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px;
    }
    
    .demo-section {
      margin-bottom: 48px;
    }
    
    .demo-section h2 {
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 24px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }
    
    .demo-section h3 {
      font-size: 16px;
      font-weight: 500;
      margin: 24px 0 12px;
      color: var(--fg);
      opacity: 0.8;
    }
    
    .demo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }
    
    .demo-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      margin-bottom: 12px;
    }
    
    .demo-spacer {
      height: 1px;
      background: var(--border);
      margin: 24px 0;
    }
    
    .component-preview {
      padding: 24px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--accent-primary, var(--red));
      text-decoration: none;
      margin-bottom: 24px;
      font-weight: 500;
    }
    
    .back-link:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="demo-container">
    <a href="/" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Back to App
    </a>
    
    <h1 style="font-size: 32px; font-weight: 700; margin-bottom: 8px;">Odysseus UI Components</h1>
    <p style="opacity: 0.7; margin-bottom: 48px;">A shadcn/ui-inspired component library for vanilla JavaScript</p>

    <!-- Buttons Section -->
    <section class="demo-section">
      <h2>Buttons</h2>
      
      <h3>Variants</h3>
      <div class="demo-row">
        <button class="btn btn-primary">Primary</button>
        <button class="btn btn-secondary">Secondary</button>
        <button class="btn btn-ghost">Ghost</button>
        <button class="btn btn-outline">Outline</button>
        <button class="btn btn-destructive">Destructive</button>
      </div>
      
      <h3>Sizes</h3>
      <div class="demo-row">
        <button class="btn btn-sm btn-primary">Small</button>
        <button class="btn btn-primary">Default</button>
        <button class="btn btn-lg btn-primary">Large</button>
      </div>
      
      <h3>States</h3>
      <div class="demo-row">
        <button class="btn btn-primary" disabled>Disabled</button>
        <button class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          With Icon
        </button>
      </div>
    </section>

    <!-- Cards Section -->
    <section class="demo-section">
      <h2>Cards</h2>
      <div class="demo-grid">
        <div class="card">
          <div class="card-header">
            <h3>Card Title</h3>
            <p>A brief description of this card</p>
          </div>
          <div class="card-content">
            <p>This is a basic card component with header, content, and footer sections. Cards are great for grouping related information.</p>
          </div>
          <div class="card-footer">
            <button class="btn btn-secondary">Cancel</button>
            <button class="btn btn-primary">Save</button>
          </div>
        </div>
        
        <div class="card">
          <div class="card-content">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
              <div class="avatar">JD</div>
              <div>
                <div style="font-weight: 600;">John Doe</div>
                <div style="font-size: 13px; opacity: 0.7;">john@example.com</div>
              </div>
            </div>
            <p style="font-size: 14px; opacity: 0.8;">This card demonstrates using avatars and text together in a card layout.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Form Elements Section -->
    <section class="demo-section">
      <h2>Form Elements</h2>
      
      <div class="demo-grid">
        <div class="component-preview">
          <h3>Inputs</h3>
          <div style="margin-bottom: 16px;">
            <label class="input-label" for="demo-name">Full Name</label>
            <input type="text" id="demo-name" class="input" placeholder="Enter your name">
          </div>
          <div style="margin-bottom: 16px;">
            <label class="input-label" for="demo-email">Email</label>
            <input type="email" id="demo-email" class="input" placeholder="you@example.com">
            <span class="input-description">We'll never share your email.</span>
          </div>
          <div>
            <label class="input-label" for="demo-select">Country</label>
            <select id="demo-select" class="select">
              <option value="">Select a country</option>
              <option value="us">United States</option>
              <option value="uk">United Kingdom</option>
              <option value="ca">Canada</option>
              <option value="au">Australia</option>
            </select>
          </div>
        </div>
        
        <div class="component-preview">
          <h3>Textarea</h3>
          <div style="margin-bottom: 16px;">
            <label class="input-label" for="demo-message">Message</label>
            <textarea id="demo-message" class="textarea" placeholder="Type your message..." rows="4"></textarea>
          </div>
          
          <h3>Checkbox</h3>
          <label class="checkbox-wrapper" style="margin-bottom: 8px;">
            <input type="checkbox">
            <span class="checkbox"></span>
            <span>I agree to the terms and conditions</span>
          </label>
          <label class="checkbox-wrapper">
            <input type="checkbox" checked>
            <span class="checkbox"></span>
            <span>Subscribe to newsletter</span>
          </label>
        </div>
        
        <div class="component-preview">
          <h3>Switch / Toggle</h3>
          <label class="checkbox-wrapper" style="margin-bottom: 12px;">
            <span>Enable notifications</span>
            <span class="switch">
              <input type="checkbox" checked>
              <span class="switch-slider"></span>
            </span>
          </label>
          <label class="checkbox-wrapper" style="margin-bottom: 12px;">
            <span>Dark mode</span>
            <span class="switch">
              <input type="checkbox">
              <span class="switch-slider"></span>
            </span>
          </label>
          <label class="checkbox-wrapper">
            <span>Auto-save drafts</span>
            <span class="switch">
              <input type="checkbox" checked>
              <span class="switch-slider"></span>
            </span>
          </label>
        </div>
      </div>
    </section>

    <!-- Badges Section -->
    <section class="demo-section">
      <h2>Badges</h2>
      <div class="demo-row">
        <span class="badge">Default</span>
        <span class="badge badge-primary">Primary</span>
        <span class="badge badge-secondary">Secondary</span>
        <span class="badge badge-success">Success</span>
        <span class="badge badge-warning">Warning</span>
        <span class="badge badge-destructive">Error</span>
      </div>
      
      <h3>With Buttons</h3>
      <div class="demo-row">
        <button class="btn btn-secondary">
          Messages
          <span class="badge badge-primary" style="margin-left: 4px;">3</span>
        </button>
        <button class="btn btn-ghost">
          Notifications
          <span class="badge badge-warning" style="margin-left: 4px;">12</span>
        </button>
      </div>
    </section>

    <!-- Alerts Section -->
    <section class="demo-section">
      <h2>Alerts</h2>
      
      <div class="alert alert-info" style="margin-bottom: 16px;">
        <span class="alert-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
          </svg>
        </span>
        <div class="alert-content">
          <div class="alert-title">Information</div>
          <div class="alert-description">This is an informational message with some details.</div>
        </div>
      </div>
      
      <div class="alert alert-success" style="margin-bottom: 16px;">
        <span class="alert-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/>
          </svg>
        </span>
        <div class="alert-content">
          <div class="alert-title">Success!</div>
          <div class="alert-description">Your changes have been saved successfully.</div>
        </div>
      </div>
      
      <div class="alert alert-warning" style="margin-bottom: 16px;">
        <span class="alert-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
        </span>
        <div class="alert-content">
          <div class="alert-title">Warning</div>
          <div class="alert-description">Please review your input before continuing.</div>
        </div>
      </div>
      
      <div class="alert alert-destructive">
        <span class="alert-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/>
            <line x1="9" y1="9" x2="15" y2="15"/>
          </svg>
        </span>
        <div class="alert-content">
          <div class="alert-title">Error</div>
          <div class="alert-description">Something went wrong. Please try again.</div>
        </div>
      </div>
    </section>

    <!-- Progress & Skeleton Section -->
    <section class="demo-section">
      <h2>Progress & Loading</h2>
      
      <h3>Progress Bars</h3>
      <div style="margin-bottom: 24px;">
        <div class="progress" style="margin-bottom: 12px;">
          <div class="progress-bar" style="width: 25%"></div>
        </div>
        <div class="progress" style="margin-bottom: 12px;">
          <div class="progress-bar" style="width: 50%"></div>
        </div>
        <div class="progress" style="margin-bottom: 12px;">
          <div class="progress-bar" style="width: 75%"></div>
        </div>
        <div class="progress">
          <div class="progress-bar" style="width: 100%"></div>
        </div>
      </div>
      
      <h3>Skeleton Loading</h3>
      <div class="demo-grid">
        <div class="card">
          <div class="card-header">
            <div class="skeleton skeleton-title"></div>
          </div>
          <div class="card-content">
            <div style="display: flex; gap: 12px; margin-bottom: 16px;">
              <div class="skeleton skeleton-avatar"></div>
              <div style="flex: 1;">
                <div class="skeleton skeleton-text" style="width: 60%"></div>
                <div class="skeleton skeleton-text" style="width: 40%"></div>
              </div>
            </div>
            <div class="skeleton skeleton-text"></div>
            <div class="skeleton skeleton-text" style="width: 80%"></div>
            <div class="skeleton skeleton-text" style="width: 60%"></div>
          </div>
        </div>
        
        <div class="component-preview">
          <div class="skeleton skeleton-text" style="width: 90%; height: 20px; margin-bottom: 12px;"></div>
          <div class="skeleton skeleton-text" style="width: 100%; margin-bottom: 8px;"></div>
          <div class="skeleton skeleton-text" style="width: 100%; margin-bottom: 8px;"></div>
          <div class="skeleton skeleton-text" style="width: 70%;"></div>
        </div>
      </div>
    </section>

    <!-- Tabs Section -->
    <section class="demo-section">
      <h2>Tabs</h2>
      <div class="tabs" style="max-width: 600px;">
        <div class="tabs-list">
          <button class="tab-trigger active" data-tab="tab1">Account</button>
          <button class="tab-trigger" data-tab="tab2">Password</button>
          <button class="tab-trigger" data-tab="tab3">Settings</button>
        </div>
        
        <div class="tab-content active" data-tab-panel="tab1">
          <div class="card">
            <div class="card-content">
              <p>Manage your account settings here. Update your profile information, email address, and other personal details.</p>
            </div>
          </div>
        </div>
        <div class="tab-content" data-tab-panel="tab2">
          <div class="card">
            <div class="card-content">
              <p>Change your password regularly to keep your account secure. Use a strong, unique password.</p>
            </div>
          </div>
        </div>
        <div class="tab-content" data-tab-panel="tab3">
          <div class="card">
            <div class="card-content">
              <p>Configure your notification preferences, privacy settings, and other application options.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Demo Section -->
    <section class="demo-section">
      <h2>Interactive Demo</h2>
      
      <div class="demo-grid">
        <div class="component-preview">
          <h3>Toast Notifications</h3>
          <div class="demo-row" style="flex-direction: column; align-items: stretch;">
            <button class="btn btn-primary" onclick="OdysseusUI.Toast.info('Info', 'This is an informational message')">
              Show Info Toast
            </button>
            <button class="btn btn-secondary" onclick="OdysseusUI.Toast.success('Success', 'Your changes have been saved!')">
              Show Success Toast
            </button>
            <button class="btn btn-ghost" onclick="OdysseusUI.Toast.warning('Warning', 'Please review your input')">
              Show Warning Toast
            </button>
            <button class="btn btn-destructive" onclick="OdysseusUI.Toast.error('Error', 'Something went wrong!')">
              Show Error Toast
            </button>
          </div>
        </div>
        
        <div class="component-preview">
          <h3>Dialog / Modal</h3>
          <div class="demo-row" style="flex-direction: column; align-items: stretch;">
            <button class="btn btn-primary" onclick="showDemoDialog()">
              Open Dialog
            </button>
            <button class="btn btn-destructive" onclick="showConfirmDialog()">
              Show Confirmation
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Avatars Section -->
    <section class="demo-section">
      <h2>Avatars</h2>
      <div class="demo-row">
        <div class="avatar avatar-sm">A</div>
        <div class="avatar">B</div>
        <div class="avatar avatar-lg">C</div>
        <div class="avatar" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">JD</div>
        <div class="avatar">
          <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%23e06c75'/%3E%3Ctext x='16' y='22' text-anchor='middle' fill='white' font-size='14' font-family='sans-serif'%3EIMG%3C/text%3E%3C/svg%3E" alt="Sample">
        </div>
      </div>
    </section>

    <div class="demo-spacer"></div>
    
    <div style="text-align: center; padding: 48px 0;">
      <p style="opacity: 0.7; margin-bottom: 16px;">
        For complete documentation, see <code style="background: var(--panel); padding: 2px 8px; border-radius: 4px;">/static/css/COMPONENTS.md</code>
      </p>
      <a href="/" class="btn btn-primary">Back to App</a>
    </div>
  </div>

  <script src="/static/js/components.js"></script>
  <script>
    function showDemoDialog() {
      OdysseusUI.Dialog.create({
        title: 'Demo Dialog',
        content: `
          <p style="margin-bottom: 16px;">This is a demo dialog created with the OdysseusUI component library.</p>
          <div style="margin-bottom: 16px;">
            <label class="input-label" for="demo-input">Sample Input</label>
            <input type="text" id="demo-input" class="input" placeholder="Type something...">
          </div>
        `,
        footer: `
          <button class="btn btn-secondary" onclick="this.closest('.dialog-overlay').querySelector('.dialog-close').click()">Cancel</button>
          <button class="btn btn-primary" onclick="OdysseusUI.Toast.success('Saved!', 'Your input has been saved'); this.closest('.dialog-overlay').querySelector('.dialog-close').click();">Save</button>
        `,
        onClose: () => console.log('Dialog closed')
      });
    }

    function showConfirmDialog() {
      OdysseusUI.Dialog.confirm({
        title: 'Delete Item',
        message: 'Are you sure you want to delete this item? This action cannot be undone.',
        confirmText: 'Delete',
        cancelText: 'Cancel',
        confirmClass: 'btn-destructive',
        onConfirm: () => {
          OdysseusUI.Toast.success('Deleted', 'The item has been deleted.');
        },
        onCancel: () => {
          OdysseusUI.Toast.info('Cancelled', 'Deletion was cancelled.');
        }
      });
    }
  </script>
</body>
</html>